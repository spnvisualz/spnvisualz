# Use a restricted live key with only the permissions documented in
# docs/STORE_DEPLOYMENT.md. Never put a secret key in public/ or client code.
STRIPE_RESTRICTED_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_SITE_URL=https://spnvisualz.com

# Cloudflare stores the three Stripe values above as encrypted Worker secrets.
# PUBLIC_SITE_URL is a non-secret Worker variable. Never commit real values.
