{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spnvisualz",
  "account_id": "d1e7b81209dbbc87a3d8371a8f2c6a34",
  "workers_dev": true,
  "vars": {
    "PUBLIC_SITE_URL": "https://spnvisualz.com",
    "ENQUIRY_TO": "spnvisualz@gmail.com",
    "ENQUIRY_FROM": "enquiries@mail.spnvisualz.com"
  },
  "main": "worker/index.js",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [{
    "binding": "ENQUIRIES",
    "id": "12b4d82436d54f95aaf5aab89058bc5b"
  }],
  "send_email": [{
    "name": "EMAIL",
    "allowed_sender_addresses": ["enquiries@mail.spnvisualz.com"],
    "allowed_destination_addresses": ["spnvisualz@gmail.com"]
  }]
}
